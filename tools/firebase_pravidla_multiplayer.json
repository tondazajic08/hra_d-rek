{
  "rules": {
    "hraci": {
      ".read": true,
      "$id": {
        ".write": "$id.length < 25",
        ".validate": "newData.hasChildren(['n', 'r', 'x', 'y', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 17" },
        "r": { ".validate": "newData.isString() && newData.val().length < 41" },
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "a": { ".validate": "newData.isString() && newData.val().length < 13" },
        "e": { ".validate": "newData.isNumber() && newData.val() > -1 && newData.val() < 10" },
        "ek": { ".validate": "newData.isNumber()" },
        "s": { ".validate": "newData.isString() && newData.val().length < 25" },
        "v": { ".validate": "newData.val() === 1" },
        "z": { ".validate": "newData.isString() && newData.val().length < 65" },
        "m": { ".validate": "newData.isNumber()" },
        "qn": { ".validate": "newData.isNumber() && newData.val() > -1 && newData.val() < 101" },
        "qd": { ".validate": "newData.isString() && newData.val().length < 601" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "hlas": {
      "$to": {
        ".read": "$to.length < 25",
        "$msg": {
          ".write": "$to.length < 25",
          ".validate": "newData.hasChildren(['f', 'k', 'd', 't'])",
          "f": { ".validate": "newData.isString() && newData.val().length < 25" },
          "k": { ".validate": "newData.val() === 'offer' || newData.val() === 'answer'" },
          "d": { ".validate": "newData.isString() && newData.val().length < 20001" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "zapasy": {
      ".read": true,
      "$m": {
        "$id": {
          ".write": "$m.length < 41 && $id.length < 25",
          ".validate": "newData.hasChildren(['d', 't'])",
          "d": { ".validate": "newData.isString() && newData.val().length < 2001" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
